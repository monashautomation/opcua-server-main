# Copy to .env (git-ignored) and replace every value.
# Passwords are read from these environment variables; never commit real ones.

# production | legacy  (production is the safe default for deployments)
GLADOS_PROFILE=production

# Published loopback port. Change the bind IP only with firewall review.
GLADOS_BIND_IP=127.0.0.1
GLADOS_PORT=4841

# Production configuration directory (must contain production server.yaml,
# namespaces.yaml, permissions.yaml and devices/ with enforced permissions).
GLADOS_CONFIG_DIR=./config

# Server certificate and key (provisioned by scripts/generate_certificates.py).
GLADOS_CERT_DIR=./certificates

# Credentials referenced by config/server.yaml security.users[].password_env.
GLADOS_PASSWORD_ADMIN=replace-with-a-long-random-password
GLADOS_PASSWORD_HEALTH=replace-with-a-different-long-random-password

# Health check uses a dedicated client certificate for encrypted endpoints.
# Generate it with:
#   python scripts/generate_certificates.py --output certificates/health \
#     --common-name health-client --hostname health-client

